{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture.company/schemas/architecture-waiver.schema.json",
  "title": "Architecture Fitness Waiver",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "architecture.company/v1"},
    "kind": {"const": "ArchitectureWaiver"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owner"],
      "properties": {
        "id": {"type": "string", "pattern": "^AW-[A-Z0-9]+-[0-9]{3,}$"},
        "name": {"type": "string", "minLength": 5},
        "owner": {"type": "string", "minLength": 2}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fitnessFunctionIds", "targetIds", "justification", "approvedBy", "validFrom", "expiresAt"],
      "properties": {
        "fitnessFunctionIds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "targetIds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "justification": {"type": "string", "minLength": 30},
        "approvedBy": {"type": "string", "minLength": 2},
        "validFrom": {"type": "string", "format": "date"},
        "expiresAt": {"type": "string", "format": "date"},
        "adrRef": {"type": "string", "minLength": 3},
        "ticketRef": {"type": "string", "minLength": 3}
      }
    }
  }
}
