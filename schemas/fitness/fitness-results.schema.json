{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture.company/schemas/fitness-results.schema.json",
  "title": "Architecture Fitness Evaluation Results",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "evaluations", "violations", "summary"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "evaluations": {"type": "array"},
    "violations": {"type": "array"},
    "summary": {"type": "object"}
  }
}
